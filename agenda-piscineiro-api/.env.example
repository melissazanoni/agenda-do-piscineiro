# Porta da API
PORT=3333

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda_piscineiro

# Segredo usado para assinar os tokens de login (troque por um texto grande e aleatório)
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio
JWT_EXPIRES_IN=1d

# Fuso horário usado nas regras de data (RN02, RN03)
APP_TIMEZONE=America/Sao_Paulo

# Endereço do frontend (usado no CORS e no link de recuperação de senha)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# Envio de e-mail via SMTP (Mailtrap Sandbox para testes locais)
# Se deixar SMTP_HOST vazio, o link de recuperação aparece no terminal da API
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agenda do Piscineiro <no-reply@agendapiscineiro.com>"